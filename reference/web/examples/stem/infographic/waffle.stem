<div class="ig-waffle">
  <svg viewBox="0 0 135 135" role="img" aria-label="Test coverage">
    {{~#each waffle.dots}}
      <circle cx="{{@this.x}}" cy="{{@this.y}}" r="4.6" class="ig-dot{{#if @this.on}} on{{/if}}"></circle>
    {{~/each}}
  </svg>
  <div class="ig-waffle-pct">{{waffle.pct}}%</div>
</div>
