{{partial "styles"}}
<div class="ig">
  <header class="ig-hero">
    <h1>{{title}}</h1>
    <p>{{subtitle}}</p>
  </header>
  <div class="ig-grid">
    <section class="ig-card">
      <h2>Render time by phase</h2>
      {{partial "donut"}}
    </section>
    <section class="ig-card">
      <h2>Transformer stdlib by group</h2>
      {{partial "bars"}}
    </section>
    <section class="ig-card">
      <h2>Test coverage</h2>
      {{partial "waffle"}}
    </section>
    <section class="ig-card ig-wide">
      <h2>Throughput · commits / sprint · last {{spark.last}}</h2>
      {{partial "spark"}}
    </section>
  </div>
</div>
