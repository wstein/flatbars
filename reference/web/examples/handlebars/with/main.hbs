<h1>with</h1>

{{! `with` shifts the context into one object for the block. }}
{{#with person}}
  <p>{{firstname}} {{lastname}}</p>
  {{! `../` reaches back to the parent (root) context. }}
  <p>works at {{../company.name}} in {{../company.city}}.</p>
{{/with}}

{{! Block parameters name the context so you don't lose the outer scope. }}
{{#with book as |b|}}
  <p>“{{b.title}}” by {{b.author}}</p>
{{/with}}

{{!-- `with` also fails over to {{else}} when the value is missing. --}}
{{#with manager}}
  <p>Manager: {{name}}</p>
{{else}}
  <p>No manager assigned.</p>
{{/with}}
