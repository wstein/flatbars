---
// SPDX-License-Identifier: Apache-2.0
// One page per surface, on the shared reference chrome (left nav + lab theme),
// so clicking through from a reference never hits a visual seam. `minbars` and
// `rawbars` are excluded — they have comprehensive dedicated references
// (/minbars, /rawbars) that supersede a one-example lesson.
import Reference from "../layouts/Reference.astro";
import OpenInLab from "../components/OpenInLab.jsx";
import { lessons, surfaces } from "../examples.mjs";

export function getStaticPaths() {
  // Inlined (not the const below): getStaticPaths is hoisted above it, so
  // referencing the const here would hit the temporal dead zone at build time.
  const hasReference = { minbars: true, rawbars: true };
  return surfaces
    .filter((s) => !hasReference[s])
    .map((s) => ({ params: { surface: s }, props: { lesson: lessons[s], surface: s } }));
}

// Surfaces with a comprehensive dedicated reference (used for nav links below).
const HAS_REFERENCE = { minbars: "/minbars", rawbars: "/rawbars" };

const { lesson, surface } = Astro.props;
const shortName = (s) => lessons[s].title.split(" — ")[0];

const groups = [
  { label: "Reference", items: [{ href: "/minbars", label: "MinBars reference" }, { href: "/rawbars", label: "RawBars reference" }] },
  {
    label: "The four surfaces",
    items: surfaces.map((s) => ({
      href: HAS_REFERENCE[s] ?? `/${s}`,
      label: s === "minbars" ? "MinBars (Mustache)" : shortName(s),
      active: s === surface,
    })),
  },
  { label: "Play", items: [{ href: `/lab/index.html?engine=${lesson.engine}`, label: "FlatBars Lab ↗" }] },
];
---

<Reference title={lesson.title} subtitle={lesson.blurb} groups={groups} spec={lesson.spec}>
  <section>
    <h2>Live example</h2>
    <p>Rendered through the real <code>{lesson.engine}</code> engine — edit it in the Lab to explore further.</p>
    <OpenInLab
      client:visible
      engine={lesson.engine}
      template={lesson.template}
      data={lesson.data}
      partials={lesson.partials ?? {}}
    />
  </section>
</Reference>
