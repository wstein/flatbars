---
// SPDX-License-Identifier: Apache-2.0
// Shared lesson chrome. The `spec` prop is the Antora page that owns the
// *normative* description — the tutorial links to it and never forks the text
// (consensus item 4). SPEC_BASE is where the Antora site is published.
const SPEC_BASE = import.meta.env.PUBLIC_SPEC_BASE || "/barebars/";
const { title, surface, spec, blurb } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · BareBars tutorials</title>
    <style>
      :root { color-scheme: light dark; --fg:#1a1a1a; --muted:#666; --line:#ddd; --accent:#5b4cff; }
      @media (prefers-color-scheme: dark) { :root { --fg:#e6e6e6; --muted:#9a9a9a; --line:#333; --accent:#9a8cff; } }
      body { font:16px/1.6 system-ui, sans-serif; color:var(--fg); max-width:48rem; margin:2rem auto; padding:0 1rem; }
      nav a { color:var(--muted); text-decoration:none; }
      .badge { display:inline-block; font:600 12px/1 ui-monospace, monospace; text-transform:uppercase; letter-spacing:.05em; color:var(--accent); border:1px solid var(--accent); border-radius:4px; padding:3px 6px; }
      .oil-grid { display:grid; grid-template-columns:1fr 1fr; gap:1rem; }
      @media (max-width:40rem) { .oil-grid { grid-template-columns:1fr; } }
      .oil-pane figcaption { font:600 11px/1 ui-monospace, monospace; text-transform:uppercase; color:var(--muted); margin:0 0 .25rem; }
      .oil-pane pre { background:color-mix(in srgb, var(--fg) 6%, transparent); border:1px solid var(--line); border-radius:6px; padding:.6rem; overflow:auto; margin:0; }
      .oil-err { color:#c0392b; }
      .oil-btn { display:inline-block; margin-top:1rem; background:var(--accent); color:#fff; text-decoration:none; font-weight:600; padding:.5rem .9rem; border-radius:6px; }
      .oil-btn[aria-disabled="true"] { opacity:.5; pointer-events:none; }
    </style>
  </head>
  <body>
    <nav><a href="/">← all surfaces</a></nav>
    <h1><span class="badge">{surface}</span> {title}</h1>
    <p>{blurb}</p>
    <slot />
    <p style="margin-top:2rem; color:var(--muted)">
      Normative reference: <a href={`${SPEC_BASE}${spec}.html`}>{spec}.adoc ↗</a> —
      the spec is the contract; this lesson only illustrates it.
    </p>
  </body>
</html>
