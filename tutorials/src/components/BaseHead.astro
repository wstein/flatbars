---
// SPDX-License-Identifier: Apache-2.0
//
// The single shared <head> for the tutorials site: meta, the one canonical font
// link, and the lab design tokens (which carry `color-scheme`). Used by BOTH the
// landing (index.astro) and the reference layout (Reference.astro) so the two
// can't drift on fonts or token wiring again — they had already diverged (the
// landing was missing a Mono weight and the preconnects). `title` is the full
// <title> string the page wants.
// The umbrella chrome tokens (single source) + the syntax palette / YAML / JSONata
// token rules (lab-tokens.css). The chrome must load first so its `:root` values
// are in place; lab-tokens.css now carries only the highlighter tokens.
import "../../../shared/flatbars-chrome.css";
import "../styles/lab-tokens.css";

const { title } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* Anti-flash: set the explicit [data-theme] on <html> before first paint, from
    the single shared `flatbars-theme` key (the topbar Theme control persists
    there, shared across the whole umbrella) or, on first visit, the OS
    preference. Tokens key dark mode off [data-theme="dark"], so this must run
    before the stylesheet paints. This is the canonical seed (shared/theme-seed.js);
    `check:theme-seed` pins that every copy matches. */}
<script is:inline>
  (function () {
    try {
      var k = "flatbars-theme";
      var t = localStorage.getItem(k);
      if (t !== "light" && t !== "dark") {
        t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
      }
      document.documentElement.dataset.theme = t;
    } catch (e) {}
  })();
</script>
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap"
  media="print"
  onload="this.media='all'"
/>
