---
// SPDX-License-Identifier: Apache-2.0
//
// The topbar "Legend" button + its colour-legend popover. With the move to
// INNER-TOKEN highlighting (ADR-014 amendment) the colours mark a token's ROLE —
// not one hue per construct — so this is a TOKEN-ROLE key: each sample is painted
// by the REAL engine (`highlightTemplate`, the shared inner-token painter the
// runnable examples and the Lab editor use), so the legend can never drift from
// what the page actually renders. The per-row `dialect` picks the lexer config
// that makes that construct light up (set delimiters need a Mustache-family one).
import { highlightTemplate } from "../lib/highlight.mjs";

// One row per token ROLE. The sample is the smallest tag that surfaces the role;
// the bold role word in `note` names the coloured token (braces appear in every
// sample, so the description points at the one that carries the row's colour).
const ROLES = [
  { code: "{{#each rows}}", dialect: "fullbars", name: "Braces & keywords",
    note: "the {{ }} delimiters, block sigils (# ^ /) and clause words (else)" },
  { code: "{{> sidebar}}", dialect: "fullbars", name: "Operation & partial",
    note: "a called helper or an included partial — the name in head position" },
  { code: "{{user.name}}", dialect: "fullbars", name: "Value & path",
    note: "a value or dotted path passed to a tag — bold, in the default colour" },
  { code: "{{gt score 90}}", dialect: "fullbars", name: "Number",
    note: "a numeric literal" },
  { code: '{{eq role "admin"}}', dialect: "fullbars", name: "String",
    note: "a quoted string literal" },
  { code: "{{! editorial note }}", dialect: "fullbars", name: "Comment",
    note: "dropped from output — shown italic" },
  { code: "{{=<% %>=}}", dialect: "minbars", name: "Set delimiters",
    note: "switches the {{ }} pair (MinBars)" },
];
---

<div class="hdr-ctrl legend-anchor">
  <button class="hdr-btn" id="legendBtn" aria-haspopup="dialog" aria-expanded="false" title="Show the colour legend">
    <span class="lg-swatch" aria-hidden="true"><i></i><i></i><i></i><i></i></span>Legend
  </button>
  <div class="legend-pop" id="legendPop" role="dialog" aria-label="Colour legend" hidden>
    <div class="legend-pop-head">
      <span class="lph-title">Colour legend</span>
      <span class="lph-sub">what each colour means inside a tag</span>
    </div>
    <dl class="legend-roles">
      {ROLES.map((r) => (
        <div class="lr-row">
          <dt><code class="lr-code" set:html={highlightTemplate(r.code, r.dialect)} /></dt>
          <dd><b>{r.name}</b><span class="lr-note">{r.note}</span></dd>
        </div>
      ))}
    </dl>
    <p class="legend-foot">
      <b>Reading the system:</b> colours mark a token's <em>role</em>, not the
      construct — braces &amp; keywords share one hue, operations &amp; partials
      another, and each literal its own. The whole tag is bold. This is the same
      inner-token scheme as the FlatBars <strong>VS&nbsp;Code</strong> extension.
    </p>
  </div>
</div>

<style>
  .legend-roles { margin: 0.7rem 0 0; display: grid; gap: 0.6rem; }
  .lr-row {
    display: grid;
    grid-template-columns: minmax(0, auto) 1fr;
    align-items: baseline;
    gap: 0.9rem;
  }
  .lr-row dt { margin: 0; min-width: 0; }
  .lr-row dd { margin: 0; min-width: 0; }
  .lr-row dd b { display: block; font-size: 0.8rem; color: var(--fg); font-weight: 600; }
  .lr-note { display: block; font-size: 0.75rem; color: var(--fg-faint); }
  .lr-code {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    white-space: nowrap;
    background: none;
    padding: 0;
  }
</style>
