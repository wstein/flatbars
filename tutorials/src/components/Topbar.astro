---
// SPDX-License-Identifier: Apache-2.0
//
// The one app topbar, shared by the docs layout (Reference.astro) AND the
// landing — the shared, zero-dependency <flatbars-topbar> custom element
// (shared/flatbars-topbar.mjs), the SAME element the Starlight spec and the
// static Lab mount. It owns the wordmark, the context switcher
// (Home · Tutorials · Spec · Lab), the Theme control (persisted to the single
// `flatbars-theme` key), Search and GitHub. The only host control is the docs
// sidebar nav-toggle, forwarded into the element's `start` slot by Reference.astro
// on narrow screens.
import "../styles/docs-chrome.css";

const { section = "tutorials", labEngine = "minbars" } = Astro.props;
// Empty at root/dev, "/flatbars" on the Pages project sub-path. The element
// resolves every cross-app link from it.
const BASE = import.meta.env.PUBLIC_BASE_PATH || "";
---

<flatbars-topbar
  section={section}
  base={BASE}
  version="v0.1.0"
  lab-engine={labEngine}
  search-index="/search-index.json"
>
  <slot name="start" />
</flatbars-topbar>

<script>
  // Define the shared custom element on the client (the import is a side effect).
  import "../../../shared/flatbars-topbar.mjs";

  // Astro consumes the `slot` attribute on a plain element's child, so assign the
  // docs sidebar nav-toggle to the element's `start` slot at runtime.
  document.querySelector("flatbars-topbar #navToggle")?.setAttribute("slot", "start");
</script>
