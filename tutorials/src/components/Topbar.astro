---
// SPDX-License-Identifier: Apache-2.0
//
// The one app topbar, shared by the docs layout (Reference.astro) AND the
// landing — so the first click no longer changes the chrome. Wordmark · Theme ·
// Legend · "Open the Lab", plus the control-wiring script (Theme on <html>, the
// Legend popover) and persistence. The page owns any content-specific scripts
// (scroll-spy, inline-code highlighting). `<slot name="start" />` is for the docs
// nav-toggle. (The old whole-tag "Chips" tint/outline/solid control was retired
// with the move to inner-token highlighting — there is no longer one colour per
// tag to tint; see the ADR-014 amendment.)
import Wordmark from "./Wordmark.astro";
import LegendPopover from "./LegendPopover.astro";
import "../styles/docs-chrome.css";

const { suffix = "", labEngine = "minbars" } = Astro.props;
const LAB_URL = import.meta.env.PUBLIC_LAB_URL || "/lab/index.html";
---

<header class="topbar">
  <slot name="start" />
  <Wordmark href="/" suffix={suffix} />
  <div class="topbar-tools">
    <div class="hdr-ctrl">
      <span class="lbl">Theme</span>
      <div class="seg" data-set="theme" role="group" aria-label="Theme">
        <button type="button" data-val="light">Light</button>
        <button type="button" data-val="dark">Dark</button>
      </div>
    </div>
    <LegendPopover />
    <a class="lab-link" href={`${LAB_URL}?engine=${labEngine}`} target="_blank" rel="noopener">Open the Lab ↗</a>
  </div>
</header>

<script>
  // Theme (html[data-theme]) segmented control and the Legend popover.
  // Persistence shares the localStorage key the anti-flash <head> script reads
  // (Theme is also set there before first paint).
  const STORE = "flatbars-docs-opts";
  const TARGET = { theme: document.documentElement };
  const curVal = (key) => TARGET[key].dataset[key];

  function syncButtons() {
    document.querySelectorAll(".seg").forEach((seg) => {
      const cur = curVal(seg.dataset.set);
      seg.querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.val === cur)));
    });
  }
  function persist() {
    try {
      localStorage.setItem(STORE, JSON.stringify({ theme: curVal("theme") }));
    } catch (e) {}
  }
  try {
    const s = JSON.parse(localStorage.getItem(STORE) || "{}");
    if (s.theme) document.documentElement.dataset.theme = s.theme;
  } catch (e) {}

  document.querySelectorAll(".seg").forEach((seg) => {
    seg.addEventListener("click", (e) => {
      const btn = e.target.closest("button");
      if (!btn) return;
      TARGET[seg.dataset.set].dataset[seg.dataset.set] = btn.dataset.val;
      syncButtons();
      persist();
    });
  });
  syncButtons();

  const legendBtn = document.getElementById("legendBtn");
  const legendPop = document.getElementById("legendPop");
  function onOutside(e) {
    if (!legendPop.contains(e.target) && !legendBtn.contains(e.target)) closePop();
  }
  function onEsc(e) {
    if (e.key === "Escape") { closePop(); legendBtn.focus(); }
  }
  function openPop() {
    legendPop.hidden = false;
    legendBtn.setAttribute("aria-expanded", "true");
    document.addEventListener("mousedown", onOutside, true);
    document.addEventListener("keydown", onEsc, true);
  }
  function closePop() {
    legendPop.hidden = true;
    legendBtn.setAttribute("aria-expanded", "false");
    document.removeEventListener("mousedown", onOutside, true);
    document.removeEventListener("keydown", onEsc, true);
  }
  legendBtn?.addEventListener("click", () => (legendPop.hidden ? openPop() : closePop()));
</script>
