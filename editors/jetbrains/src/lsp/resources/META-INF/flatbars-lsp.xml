<idea-plugin>
  <!-- Loaded only when com.intellij.modules.ultimate is present (the platform LSP
       API is Ultimate-only). Community IDEs skip this and keep just the TextMate
       fallback registered by the base plugin. -->
  <extensions defaultExtensionNs="com.intellij">
    <platform.lsp.serverSupportProvider implementation="com.flatbars.idea.FlatBarsLspServerSupportProvider"/>
    <!-- The default-dialect setting (parity with VS Code's flatbars.defaultDialect).
         Ultimate-only, like the server it feeds; the FlatBarsSettings service is
         auto-registered via @Service. -->
    <applicationConfigurable
      instance="com.flatbars.idea.FlatBarsConfigurable"
      displayName="FlatBars"
      groupId="language"
      id="com.flatbars.settings"/>
  </extensions>
</idea-plugin>
