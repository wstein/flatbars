{
  "name": "flatbars",
  "displayName": "FlatBars",
  "description": "FlatBars / Handlebars / Mustache syntax highlighting — a TextMate fallback plus the engine-backed flatbars-lsp for correct, stateful semantic tokens (ADR-017).",
  "version": "0.1.0",
  "publisher": "flatbars",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wstein/flatbars"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:rawbars",
    "onLanguage:minbars",
    "onLanguage:fullbars",
    "onLanguage:maxbars"
  ],
  "contributes": {
    "languages": [
      {
        "id": "rawbars",
        "aliases": [
          "RawBars"
        ],
        "extensions": [
          ".rawbars",
          ".rbars"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "minbars",
        "aliases": [
          "MinBars"
        ],
        "extensions": [
          ".minbars",
          ".mbars",
          ".mustache"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "fullbars",
        "aliases": [
          "FullBars"
        ],
        "extensions": [
          ".fullbars",
          ".fbars",
          ".hbs",
          ".handlebars"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "maxbars",
        "aliases": [
          "MaxBars"
        ],
        "extensions": [
          ".maxbars",
          ".xbars"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "rawbars",
        "scopeName": "source.flatbars",
        "path": "./dist/flatbars.tmLanguage.json"
      },
      {
        "language": "minbars",
        "scopeName": "source.flatbars",
        "path": "./dist/flatbars.tmLanguage.json"
      },
      {
        "language": "fullbars",
        "scopeName": "source.flatbars",
        "path": "./dist/flatbars.tmLanguage.json"
      },
      {
        "language": "maxbars",
        "scopeName": "source.flatbars",
        "path": "./dist/flatbars.tmLanguage.json"
      },
      {
        "path": "./dist/flatbars-injection.tmLanguage.json",
        "scopeName": "flatbars.injection",
        "injectTo": [
          "source.java",
          "source.ruby",
          "source.python",
          "source.go",
          "source.js",
          "source.ts",
          "source.jsx",
          "source.tsx",
          "source.css",
          "source.scss",
          "source.less",
          "source.sql",
          "source.shell",
          "source.yaml",
          "source.json",
          "source.rust",
          "source.cpp",
          "source.cs",
          "source.kotlin",
          "source.swift",
          "source.php",
          "source.lua",
          "source.elixir",
          "text.html.basic",
          "text.html.markdown",
          "text.xml"
        ]
      }
    ],
    "configuration": {
      "title": "FlatBars",
      "properties": {
        "flatbars.defaultDialect": {
          "type": "string",
          "enum": [
            "rawbars",
            "minbars",
            "fullbars",
            "maxbars"
          ],
          "default": "fullbars",
          "description": "Dialect the FlatBars language server falls back to when the document's languageId and URI extension both fail to resolve. Defaults to FullBars (Handlebars-faithful)."
        }
      }
    },
    "snippets": [
      {
        "language": "rawbars",
        "path": "./snippets/flatbars.json"
      },
      {
        "language": "minbars",
        "path": "./snippets/flatbars.json"
      },
      {
        "language": "fullbars",
        "path": "./snippets/flatbars.json"
      },
      {
        "language": "maxbars",
        "path": "./snippets/flatbars.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "embeddedDelimiter",
        "superType": "keyword",
        "description": "A set-delimiter directive ({{=A B=}}) and the brace pair it introduces. Visually paired with the grammar's punctuation.section.embedded scope via a semanticTokenScopes mapping below."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "rawbars",
        "scopes": {
          "embeddedDelimiter": [
            "punctuation.section.embedded.flatbars"
          ]
        }
      },
      {
        "language": "minbars",
        "scopes": {
          "embeddedDelimiter": [
            "punctuation.section.embedded.flatbars"
          ]
        }
      },
      {
        "language": "fullbars",
        "scopes": {
          "embeddedDelimiter": [
            "punctuation.section.embedded.flatbars"
          ]
        }
      },
      {
        "language": "maxbars",
        "scopes": {
          "embeddedDelimiter": [
            "punctuation.section.embedded.flatbars"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/sync-assets.mjs",
    "package": "node scripts/sync-assets.mjs && vsce package --no-dependencies",
    "test": "node test/package.smoke.test.mjs",
    "test:ide": "node test/ide/runTest.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "vscode-languageclient": "^10.0.0"
  },
  "icon": "icon.png",
  "bugs": {
    "url": "https://github.com/wstein/flatbars/issues"
  },
  "homepage": "https://github.com/wstein/flatbars#readme",
  "keywords": [
    "handlebars",
    "mustache",
    "templates",
    "hbs",
    "lsp",
    "flatbars",
    "rawbars",
    "minbars",
    "fullbars",
    "maxbars"
  ],
  "qna": "https://github.com/wstein/flatbars/discussions",
  "galleryBanner": {
    "color": "#7c4dff",
    "theme": "dark"
  }
}
