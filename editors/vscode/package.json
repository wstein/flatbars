{
  "name": "trussbars",
  "displayName": "Trussbars",
  "description": "Trussbars template support for `.truss` files — syntax highlighting (a TextMate fallback) plus the engine-backed language server for correct, stateful semantic tokens and diagnostics (ADR-017). Trussbars is the production Rust template engine built on the FlatBars MaxBars surface.",
  "version": "0.1.0",
  "publisher": "flatbars",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wstein/flatbars"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:trussbars"
  ],
  "contributes": {
    "languages": [
      {
        "id": "trussbars",
        "aliases": [
          "Trussbars"
        ],
        "extensions": [
          ".truss"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "trussbars",
        "scopeName": "source.flatbars",
        "path": "./dist/flatbars.tmLanguage.json"
      },
      {
        "path": "./dist/flatbars-injection.tmLanguage.json",
        "scopeName": "flatbars.injection",
        "injectTo": [
          "source.java",
          "source.ruby",
          "source.python",
          "source.go",
          "source.js",
          "source.ts",
          "source.jsx",
          "source.tsx",
          "source.css",
          "source.scss",
          "source.less",
          "source.sql",
          "source.shell",
          "source.yaml",
          "source.json",
          "source.rust",
          "source.cpp",
          "source.cs",
          "source.kotlin",
          "source.swift",
          "source.php",
          "source.lua",
          "source.elixir",
          "text.html.basic",
          "text.html.markdown",
          "text.xml"
        ]
      }
    ],
    "configuration": {
      "title": "FlatBars",
      "properties": {
        "flatbars.defaultDialect": {
          "type": "string",
          "enum": [
            "trussbars"
          ],
          "default": "trussbars",
          "description": "Language the Trussbars server falls back to when the document's languageId and URI extension both fail to resolve. The extension is Trussbars-only, so this is always `trussbars`."
        }
      }
    },
    "snippets": [
      {
        "language": "trussbars",
        "path": "./snippets/flatbars.json"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "embeddedDelimiter",
        "superType": "keyword",
        "description": "A set-delimiter directive ({{=A B=}}) and the brace pair it introduces under a switched delimiter. Visually paired with the grammar's punctuation.section.embedded.flatbars scope via a semanticTokenScopes mapping, so themes paint the LSP-emitted spans the same colour as the grammar-emitted ones without per-theme work."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "trussbars",
        "scopes": {
          "embeddedDelimiter": [
            "punctuation.section.embedded.flatbars"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "comment.block.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "invalid.illegal.unterminated.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.control.import.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.control.inheritance.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.control.section.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "keyword.directive.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "meta.embedded.block.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "meta.embedded.line.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "punctuation.definition.comment.begin.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "punctuation.definition.comment.end.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "punctuation.section.embedded.begin.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          },
          {
            "scope": "punctuation.section.embedded.end.flatbars",
            "settings": {
              "fontStyle": "bold"
            }
          }
        ]
      },
      "editor.semanticTokenColorCustomizations": {
        "[trussbars]": {
          "enabled": true,
          "rules": {
            "comment": {
              "fontStyle": "bold"
            },
            "embeddedDelimiter": {
              "fontStyle": "bold"
            },
            "function": {
              "fontStyle": "bold"
            },
            "keyword": {
              "fontStyle": "bold"
            },
            "macro": {
              "fontStyle": "bold"
            },
            "number": {
              "fontStyle": "bold"
            },
            "operator": {
              "fontStyle": "bold"
            },
            "string": {
              "fontStyle": "bold"
            },
            "variable": {
              "fontStyle": "bold"
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/sync-assets.mjs",
    "package": "node scripts/sync-assets.mjs && vsce package --no-dependencies",
    "test": "node test/package.smoke.test.mjs",
    "test:ide": "node test/ide/runTest.mjs"
  },
  "devDependencies": {
    "@vscode/test-electron": "2.5.2",
    "vscode-languageclient": "^10.0.0"
  },
  "icon": "icon.png",
  "bugs": {
    "url": "https://github.com/wstein/flatbars/issues"
  },
  "homepage": "https://github.com/wstein/flatbars#readme",
  "keywords": [
    "trussbars",
    "truss",
    "templates",
    "rust",
    "lsp",
    "flatbars",
    "template-engine"
  ],
  "qna": "https://github.com/wstein/flatbars/discussions",
  "galleryBanner": {
    "color": "#7c4dff",
    "theme": "dark"
  }
}
