{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FlatBars",
  "scopeName": "source.flatbars",
  "fileTypes": [
    "flatbars",
    "rawbars",
    "minbars",
    "fullbars",
    "maxbars",
    "hbs",
    "handlebars",
    "mustache"
  ],
  "uuid": "47231B67-C29F-40A3-9604-097652D77088",
  "_doc": [
    "The FlatBars TextMate fallback — a THIN FLOOR per ADR-017. It recognises only",
    "the bracket-delimiter shapes ({{ {{# {{/ {{^ {{< {{$ {{> {{= {{! {{!-- {{{ {{&",
    "{{{{ {{{{# {{{{/ and their closers) and scopes the whole tag region with a",
    "Handlebars-style meta name so themes can chip it. Inside a tag the body is",
    "default-coloured; classifying helpers, paths, keywords, operators, strings, and",
    "numbers is the LSP's job (it emits semantic tokens over this floor). check:vocab",
    "asserts every vocabulary tmScope still exists in the grammar; check:tmgrammar",
    "asserts the grammar agrees with the engine on TAG BOUNDARIES (per dialect)."
  ],
  "patterns": [
    {
      "include": "#yfm"
    },
    {
      "include": "#handlebars"
    }
  ],
  "repository": {
    "yfm": {
      "patterns": [
        {
          "begin": "(?<!\\s)---\\n$",
          "end": "^---\\s",
          "name": "markup.raw.yaml.front-matter",
          "patterns": [
            {
              "include": "source.yaml"
            }
          ]
        }
      ]
    },
    "handlebars": {
      "_doc": "Dispatch order: longer bracket clusters first, then specific sigils, then the bare {{...}} variable as the catch-all.",
      "patterns": [
        { "include": "#raw_block" },
        { "include": "#long_comment" },
        { "include": "#short_comment" },
        { "include": "#set_delimiter" },
        { "include": "#triple_stash" },
        { "include": "#amp_unescaped" },
        { "include": "#block_open" },
        { "include": "#block_close" },
        { "include": "#inverse_block" },
        { "include": "#inheritance_parent" },
        { "include": "#inheritance_block" },
        { "include": "#partial" },
        { "include": "#variable" }
      ]
    },

    "raw_block": {
      "_doc": "Quad-brace raw block. Open accepts the Handlebars form {{{{name}}}} and the FlatBars-native hash form {{{{#name}}}}; close is {{{{/name}}}}. The sigil is part of the punctuation capture, mirroring {{# / {{/.",
      "name": "meta.block.raw.handlebars",
      "begin": "(\\{\\{\\{\\{\\s*#?)\\s*(?!/)[^}]*(\\}\\}\\}\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" },
        "2": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\{\\{\\{\\{\\s*/)[^}]*(\\}\\}\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" },
        "2": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "long_comment": {
      "_doc": "{{!-- ... --}} — body may contain }} that don't terminate the comment.",
      "name": "comment.block.handlebars",
      "begin": "(\\{\\{!--)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(--\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "short_comment": {
      "_doc": "{{! ... }} — comment ends at the first }}.",
      "name": "comment.block.handlebars",
      "begin": "(\\{\\{!)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "set_delimiter": {
      "_doc": "{{=A B=}} — set-delimiter directive. The stateless fallback cannot track delimiters that follow; the LSP does (token-vocabulary.json).",
      "name": "meta.set-delimiter.handlebars",
      "begin": "(\\{\\{=)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(=\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "triple_stash": {
      "_doc": "{{{x}}} — unescaped (raw) interpolation. Must come before #variable so triple braces match before double.",
      "name": "meta.variable.unescaped.handlebars",
      "begin": "(\\{\\{\\{)(?!\\{)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\}\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "amp_unescaped": {
      "_doc": "{{&x}} — Mustache-style unescaped alias for triple-stash.",
      "name": "meta.variable.unescaped.handlebars",
      "begin": "(\\{\\{&)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "block_open": {
      "_doc": "{{#name ...}} — block helper open. The # is part of the punctuation capture (same convention as {{/).",
      "name": "meta.function.block.start.handlebars",
      "begin": "(\\{\\{~?#)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(~?\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "block_close": {
      "_doc": "{{/name}} — block close. The / is part of the punctuation capture.",
      "name": "meta.function.block.end.handlebars",
      "begin": "(\\{\\{~?/)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(~?\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "inverse_block": {
      "_doc": "{{^x}} — Mustache inverted section open.",
      "name": "meta.function.block.inverse.handlebars",
      "begin": "(\\{\\{\\^)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "inheritance_parent": {
      "_doc": "{{<layout}} — Mustache inheritance parent.",
      "name": "meta.function.block.parent.handlebars",
      "begin": "(\\{\\{<)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "inheritance_block": {
      "_doc": "{{$block}} — Mustache inheritance block declaration.",
      "name": "meta.function.block.declaration.handlebars",
      "begin": "(\\{\\{\\$)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "partial": {
      "_doc": "{{> name}} (and {{>* name}}) — partial include.",
      "name": "meta.function.partial.handlebars",
      "begin": "(\\{\\{>\\*?)",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    },

    "variable": {
      "_doc": "{{name ...}} — the escape-by-default interpolation. Catch-all that runs LAST: the negative lookahead excludes every sigil already handled above.",
      "name": "meta.function.inline.handlebars",
      "begin": "(\\{\\{~?)(?![!=#/^<$>&{])",
      "beginCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      },
      "end": "(~?\\}\\})",
      "endCaptures": {
        "1": { "name": "punctuation.section.expression.flatbars" }
      }
    }
  }
}
