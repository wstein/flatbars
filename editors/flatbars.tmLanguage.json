  "repository": {
    "block_comment": {
      "patterns": [
        {
          "name": "comment.block.handlebars",
          "begin": "\\{\\{~?!--",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.handlebars"
            }
          },
          "end": "--~?\\}\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.handlebars"
            }
          },
          "patterns": [
            {
              "match": "@\\w*",
              "name": "keyword.annotation.handlebars"
            }
          ]
        }
      ]
    },
    "block_helper": {
      "name": "meta.function.block.start.handlebars",
      "begin": "(\\{\\{~?#)\\s*(?:(if|unless|each|with|else)|([-a-zA-Z0-9_./]+))",
      "beginCaptures": {
        "1": {
          "name": "punctuation.section.expression.flatbars"
