<h1>Inline partials &amp; partial blocks</h1>

{{!-- Inline partials are defined in the template and scoped to it. --}}
{{#*inline "person"}}
  <li class="person">{{name}} — <em>{{role}}</em></li>
{{/inline}}

<ul>
{{#each people}}{{> person}}{{/each}}
</ul>

{{!-- A partial BLOCK passes its body to the partial as @partial-block —
    the classic "layout" pattern. If `layout` were missing, the block
    body would render as the fallback. --}}
{{#> layout title="Team"}}
  <p>This paragraph is the block content, dropped into the layout.</p>
{{/layout}}
