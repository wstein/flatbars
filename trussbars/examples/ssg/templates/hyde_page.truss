{# Hyde's page.html: `{% extends %}` the shared base layout — imported as the
   `hyde` partial (templates/hyde_base.truss, the very file render_index renders
   directly) — and override only the `content` block with the single post. One
   base file, no duplication: a cross-file partial may now be an `{% extends %}`
   base (the engine gap this port surfaced is closed; see docs/24). #}
{% extends "hyde" %}
{% block content %}
<div class="post">
  <h1 class="post-title">{{ page.title }}</h1>
  <span class="post-date">{{ page.date | date "%Y-%m-%d" }}</span>
  {{ page.content | safe }}
</div>
{% endblock %}
