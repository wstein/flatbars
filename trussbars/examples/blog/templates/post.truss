<article>
  <h1>{{post.title}}</h1>
  <p class="meta">by {{post.author}} · {{date post.date "%B %e, %Y" "en"}} · {{post.tags | count}} tags</p>
  <div class="body">{{post.body | markdown}}</div>
  <footer>{% for tag in post.tags %}<a href="/tags/{{tag | lowercase}}">#{{tag}}</a> {% endfor %}</footer>
</article>
