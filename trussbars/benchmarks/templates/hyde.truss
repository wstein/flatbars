<!DOCTYPE html><html lang="{{lang}}"><head><meta charset="utf-8"><title>{{config.title}}</title></head><body class="{{config.extra.hyde_theme}}"><div class="sidebar"><div class="sidebar-about"><a href="{{config.base_url}}"><h1>{{config.title}}</h1></a></div><ul class="sidebar-nav">{% for link in config.extra.hyde_links %}<li class="sidebar-nav-item"><a href="{{link.url}}">{{link.name}}</a></li>{% endfor %}</ul></div><div class="content container"><div class="posts">{% for page in pages %}<div class="post"><h1 class="post-title"><a href="{{page.permalink}}">{{page.title}}</a></h1><span class="post-date">{{page.date}}</span></div>{% endfor %}</div></div></body></html>